---
// Каталог охранных комплексов StarLine.
import Base from '../layouts/Base.astro';
import Catalog, { type Item } from '../components/Catalog';
import { catalog, familyOf } from '../lib/catalog';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const n = catalog.products.length;
// В остров – только поля для плитки: функции, комплектация и матрица параметров живут в карточке товара.
const items: Item[] = catalog.products.map((p) => ({
  slug: p.slug, name: p.name, price: p.price, image: p.image,
  family: p.family, familyTitle: familyOf(p).title, funcs: p.funcs, attrs: p.attrs,
}));
const families = catalog.families.map(({ key, title }) => ({ key, title }));
---
<Base title="Охранные комплексы StarLine – каталог" description={`${n} охранных комплексов StarLine: подбор по функциям, сравнение и комплектации.`} current="catalog">
  <header class="cat-head">
    <h1>Охранные комплексы StarLine</h1>
    <p class="lead">{n} комплексов. Отметьте нужные функции – останутся только подходящие; цифра на чипе покажет, сколько их будет.</p>
  </header>
  <Catalog client:load items={items} filters={catalog.filters} families={families} base={base} />
</Base>
